{
  "name": "dsh-environment-sync",
  "version": "0.7.12",
  "description": "Open-source DSH environment synchronization and personal plugin management.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "catalog.json",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/index.js",
    "lib/private-plugin-manager.js",
    "lib/environment-workflow.js",
    "lib/environment-apply.js",
    "lib/agent-preset-sync.js",
    "lib/stale-takeover.js",
    "scripts/takeover-stale-transactions.mjs",
    "lib/typert.host.js",
    "scripts/private-environment-sync.mjs",
    "scripts/sync-third-party-plugins.mjs",
    "scripts/ensure-dsh-web.ps1",
    "scripts/bootstrap-environment.ps1",
    "scripts/recover-environment.mjs",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/agent-preset-sync.js && node --check lib/stale-takeover.js && node --check scripts/takeover-stale-transactions.mjs && node --check lib/index.js && node --check lib/private-plugin-manager.js && node --check lib/environment-workflow.js && node --check lib/environment-apply.js && node --check lib/client.js && node --check lib/typert.host.js && node --check scripts/private-environment-sync.mjs && node --check scripts/sync-third-party-plugins.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "cross-spawn": "7.0.6",
    "proper-lockfile": "4.1.2",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-plugin-manager": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.1 <0.3.0",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4.0.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-alpha.1 <0.3.0"
  },
  "author": "vb2250158",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-environment-sync.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-environment-sync#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-environment-sync/issues"
  },
  "icon": "./icon.svg"
}
